{
  "name": "ketner-station",
  "version": "0.2.0",
  "private": true,
  "description": "Ketner Station — голосовой ассистент для Windows: скажите «Кетнер», и он управляет компьютером.",
  "author": "Ketner",
  "license": "UNLICENSED",
  "main": "dist/main/index.cjs",
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "npm run build && electron .",
    "dev": "npm run build && electron . --dev",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "icons": "node scripts/make-icons.mjs",
    "dist": "npm run build && electron-builder --win nsis --x64 --publish never",
    "dist:dir": "npm run build && electron-builder --win dir --x64 --publish never"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "fflate": "^0.8.3",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5",
    "vosk-browser": "^0.0.8"
  },
  "build": {
    "appId": "org.ketner.station",
    "productName": "Ketner Station",
    "copyright": "Ketner",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "!dist/**/*.map",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources",
        "to": "resources",
        "filter": [
          "*.png"
        ]
      }
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "language": "1049",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "shortcutName": "Ketner Station",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false
    }
  }
}
